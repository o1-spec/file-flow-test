# S3 / Object Storage Configuration (MinIO or Cloudflare R2 / AWS S3)
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=your_s3_access_key
S3_SECRET_KEY=your_s3_secret_key
S3_BUCKET=filepipeline

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:password@localhost:5433/filepipeline

# Redis Connection URL (for BullMQ queues and worker heartbeats)
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here

# Admin Email Allowlist (comma-separated for multiple admins)
ADMIN_EMAILS=admin@example.com

# Server Port (optional, defaults to 4000)
PORT=4000

# MCPx Reliable Orchestration Control Plane
MCPX_BASE_URL=http://localhost:3000

# AI Operations Agent LLM Provider (gemini | openai | development-fallback)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

