# Backend API Base URL (defaults to http://localhost:4000 if omitted)
NEXT_PUBLIC_API_URL=http://localhost:4000

# MCPx Coordinator URL — used to construct the "View transaction in MCPx" link.
# Set to the public HTTPS MCPx coordinator URL in production.
# Development default: http://localhost:3000
NEXT_PUBLIC_MCPX_CONSOLE_URL=http://localhost:3000
